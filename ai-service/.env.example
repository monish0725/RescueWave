# The AI service authenticates to the backend AS the camera owner's own
# account (it only ever acts on cameras that account actually owns — see
# backend/src/routes/cameras.js and missingPersons.js for the ownership
# checks). Use a real RescueWave account here, not a throwaway one, since
# any camera it processes must already be registered under this account.
RESCUEWAVE_API_URL=http://localhost:4000/api
# For a quick local demo, create this account from backend/ with:
#   node src/admin-cli.js ensure-ai-demo camowner@example.com change_me --camera
# Otherwise replace these with any real RescueWave account that owns a
# stream-enabled camera.
RESCUEWAVE_EMAIL=camowner@example.com
RESCUEWAVE_PASSWORD=change_me

# Comma-separated camera IDs to run against. Leave blank to auto-discover
# every one of this account's cameras that has a stream_url configured
# (GET /api/cameras/mine/streaming).
CAMERA_IDS=

# Optional precise location for a local Mac webcam/demo feed. If your
# camera record already has lat/lng, you can leave these blank. Set these
# when using stream_url=0 or another local webcam source so email/SMS
# alerts include exact coordinates and a Google Maps link.
CAMERA_LOCATION_ADDRESS=
CAMERA_LOCATION_LAT=
CAMERA_LOCATION_LNG=

# Face matching
# Face matching — InsightFace (SCRFD detection + ArcFace/buffalo_l
# recognition). 0.5 is the standard cosine-similarity threshold for this
# model; FACE_MATCH_DET_SIZE trades accuracy for speed (320 is a good
# default for a periodic poll, not a live 30fps loop); requiring several
# consecutive matching poll cycles before reporting cuts down false
# positives from one lucky-looking frame.
FACE_MATCH_CONFIDENCE_THRESHOLD=0.5
FACE_MATCH_POLL_SECONDS=5
FACE_MATCH_DET_SIZE=320
FACE_MATCH_CONSECUTIVE_FRAMES=3
FACE_MATCH_COOLDOWN_SECONDS=300
MISSING_PERSONS_REFRESH_SECONDS=120

# Face quality gates — a detected face has to clear ALL of these before
# it's even compared against the reference set, so an obviously bad
# detection can't win a "best face in frame" comparison just because
# nothing else beat it. FACE_QUALITY_* apply to faces seen in a live CCTV
# frame; REFERENCE_* apply once, to a missing person's uploaded reference
# photo (kept separate so tuning one doesn't silently move the other).
FACE_QUALITY_MIN_DET_SCORE=0.5
FACE_QUALITY_MIN_FACE_SIZE_PX=40
FACE_QUALITY_MIN_SHARPNESS=40.0
REFERENCE_MIN_FACE_SIZE_PX=80
REFERENCE_MIN_SHARPNESS=40.0

# SOS module (gesture/voice/emotion) — each sub-detector degrades
# gracefully if its optional dependency/model isn't present.
SOS_ENABLED=true
SOS_HOLD_SECONDS=1.0
SOS_COOLDOWN_SECONDS=30
VOSK_MODEL_PATH=
EMOTION_MODEL_PATH=
FALL_DETECTION_ENABLED=true
FALL_DETECTION_MODEL_PATH=/absolute/path/to/rescuewave-final2/fall-detection/yolo11n.pt
FALL_PERSON_CONFIDENCE=0.55
FALL_MIN_PERSON_WIDTH=100
FALL_MIN_PERSON_HEIGHT=150
FALL_HORIZONTAL_RATIO=1.25
FALL_MOVEMENT_MIN_DELTA=4
FALL_MOVEMENT_MEMORY_SECONDS=1.5
FALL_CONFIRM_SECONDS=2.0
FALL_HOLD_SECONDS=8.0
FALL_EVENT_COOLDOWN_SECONDS=20.0
IRREGULAR_POSTURE_CONFIRM_SECONDS=4.0

# Transparent weighted threat-score fusion — each signal contributes this
# many points (0-100 scale, capped) toward whether an alert fires. See
# rescuewave_ai/sos/threat_score.py. An alert only fires once the total
# crosses THREAT_SCORE_ALERT_THRESHOLD, so no single weak signal (e.g.
# emotion alone, worth 20 by default) can ever trigger one on its own.
THREAT_WEIGHT_GESTURE=40
THREAT_WEIGHT_VOICE=30
THREAT_WEIGHT_EMOTION=20
THREAT_WEIGHT_REPEATED=10
THREAT_WEIGHT_FALL=70
THREAT_WEIGHT_IRREGULAR_POSTURE=35
THREAT_SCORE_ALERT_THRESHOLD=40

# Set true to actually open a display window (cv2.imshow) while running
# locally for a demo. Leave false on a headless server.
SHOW_PREVIEW_WINDOW=true

# Optional direct alert channels from the AI service, in addition to the
# RescueWave backend notifications. Leave blank to disable.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

TWILIO_SID=
TWILIO_AUTH=
TWILIO_FROM=
TWILIO_TO=
TWILIO_CALL_TO=
